<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF1C1B1F">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:paddingTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card: Version Selector -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_play"
                    android:textSize="20sp"
                    android:textColor="#FFE6E1E5"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select game version"
                    android:textSize="13sp"
                    android:textColor="#FFCAC4D0"
                    android:layout_marginTop="2dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <com.kdt.mcgui.mcVersionSpinner
                        android:id="@+id/mc_version_spinner"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="#FF1C1B1F"
                        android:paddingHorizontal="16dp"
                        android:gravity="center_vertical"
                        android:drawableEnd="@drawable/spinner_arrow" />

                    <ImageButton
                        android:id="@+id/edit_profile_button"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:src="@drawable/ic_px_edit"
                        android:padding="12dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Section: Tools -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOOLS"
                android:textSize="12sp"
                android:textColor="#FFCAC4D0"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"
                android:letterSpacing="0.1" />

            <!-- Card: Tools -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="8dp"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/custom_control_button"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:drawableStart="@drawable/ic_px_gamepad"
                    android:drawablePadding="12dp"
                    android:text="@string/mcl_option_customcontrol"
                    android:textColor="#FFE6E1E5"
                    android:textSize="15sp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#FF938F99"
                    android:alpha="0.3" />

                <Button
                    android:id="@+id/install_jar_button"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:drawableStart="@drawable/ic_px_java_run"
                    android:drawablePadding="12dp"
                    android:text="@string/main_install_jar_file"
                    android:textColor="#FFE6E1E5"
                    android:textSize="15sp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#FF938F99"
                    android:alpha="0.3" />

                <Button
                    android:id="@+id/open_files_button"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:drawableStart="@drawable/ic_px_folder"
                    android:drawablePadding="12dp"
                    android:text="@string/mcl_button_open_directory"
                    android:textColor="#FFE6E1E5"
                    android:textSize="15sp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="8dp" />

            </LinearLayout>

            <!-- Section: Downloads -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DOWNLOADS"
                android:textSize="12sp"
                android:textColor="#FFCAC4D0"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"
                android:letterSpacing="0.1" />

            <!-- Card: Downloads -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="8dp"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/search_mods_button"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:drawableStart="@drawable/ic_px_hash"
                    android:drawablePadding="12dp"
                    android:text="Search mods"
                    android:textColor="#FFE6E1E5"
                    android:textSize="15sp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#FF938F99"
                    android:alpha="0.3" />

                <Button
                    android:id="@+id/news_button"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:drawableStart="@drawable/ic_px_book"
                    android:drawablePadding="12dp"
                    android:text="@string/mcl_tab_wiki"
                    android:textColor="#FFE6E1E5"
                    android:textSize="15sp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#FF938F99"
                    android:alpha="0.3" />

                <Button
                    android:id="@+id/share_logs_button"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:drawableStart="@drawable/ic_px_sharelog"
                    android:drawablePadding="12dp"
                    android:text="@string/main_share_logs"
                    android:textColor="#FFE6E1E5"
                    android:textSize="15sp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="8dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom: Play Button Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:background="#FF1C1B1F">

        <Button
            android:id="@+id/play_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/main_play"
            android:textAllCaps="true"
            android:textSize="17sp"
            android:textStyle="bold"
            android:backgroundTint="#FFD0BCFF"
            android:textColor="#FF381E72" />

    </LinearLayout>

</LinearLayout>